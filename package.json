{
  "name": "unity-asset-library",
  "version": "0.2.3",
  "private": true,
  "description": "A focused desktop library for Unity assets",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/prepare-electron.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "prestart": "node scripts/prepare-electron.cjs",
    "start": "electron .",
    "package": "bash scripts/prepare-python.sh && npm run build && electron-builder --mac --arm64 --dir --publish never",
    "dist": "bash scripts/prepare-python.sh && npm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@gluestack-ui/core": "4.0.0-alpha.0",
    "@gluestack-ui/utils": "4.0.0-alpha.0",
    "@react-aria/checkbox": "^3.17.1",
    "@react-aria/dialog": "^3.6.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/label": "^3.8.1",
    "@react-aria/menu": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/radio": "^3.13.1",
    "@react-aria/selection": "^3.28.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/switch": "^3.8.1",
    "@react-aria/utils": "^3.34.1",
    "@react-aria/visually-hidden": "^3.9.1",
    "@react-stately/checkbox": "^3.8.1",
    "@react-stately/collections": "^3.13.1",
    "@react-stately/menu": "^3.10.1",
    "@react-stately/overlays": "^3.7.1",
    "@react-stately/radio": "^3.12.1",
    "@react-stately/slider": "^3.8.1",
    "@react-stately/toggle": "^3.10.1",
    "@react-stately/tree": "^3.10.1",
    "@react-stately/utils": "^3.12.1",
    "lucide-react": "^1.41.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-native-web": "0.20.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.unityassetlibrary.viewer",
    "productName": "Unity Asset Library",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "ual-backend/bin",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": ".build/python/cpython-3.12.11-macos-aarch64-none",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
