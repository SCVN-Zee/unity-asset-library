{
  "name": "unity-asset-index",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop library for Unity assets",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.unityassetindex.viewer",
    "productName": "Unity Asset Index",
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "uai-backend/bin"
      },
      {
        "from": "config.json",
        "to": "uai-backend/config.json"
      },
      {
        "from": "state",
        "to": "uai-backend/state",
        "filter": [
          "**/*",
          "!server-instance.lock",
          "!state-write.lock",
          "!cache-write.lock"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
